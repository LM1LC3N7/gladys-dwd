          "label": {
            "en": "Level reached",
            "fr": "Niveau atteint",
            "de": "Erreichte Stufe"
          },
          "description": {
            "en": "Empty: any level. Fires even when the index jumps over this level.",
            "fr": "Vide : tous les niveaux. Se déclenche même si l’indice saute ce niveau.",
            "de": "Leer: jede Stufe. Löst auch aus, wenn der Index diese Stufe überspringt."
          },
          "options": [
            {
              "value": "none",
              "label": {
                "en": "None (0)",
                "fr": "Aucune (0)",
                "de": "Keine (0)"
