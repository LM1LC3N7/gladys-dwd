    {
      "key": "pollen_level_changed",
      "label": {
        "en": "Pollen level changed",
        "fr": "Niveau de pollens changé",
        "de": "Pollenbelastung geändert"
      },
      "description": {
        "en": "The DWD pollen index of a house reached a new exposure level (the highest pollen of the day).",
        "fr": "L’indice pollinique du DWD d’une maison a atteint un nouveau niveau d’exposition (le pollen le plus présent du jour).",
        "de": "Der Pollenindex des DWD für ein Zuhause hat eine neue Belastungsstufe erreicht (der stärkste Pollen des Tages)."
      },
      "fields": [
