            },
            {
              "value": "low",
              "label": {
                "en": "Low (1)",
                "fr": "Faible (1)",
                "de": "Gering (1)"
              }
            },
            {
              "value": "moderate",
              "label": {
                "en": "Moderate (2)",
                "fr": "Moyenne (2)",
                "de": "Mittel (2)"
              }
            },
            {
              "value": "high",
              "label": {
                "en": "High (3)",
                "fr": "Forte (3)",
                "de": "Hoch (3)"
